vars: {
	d2-config: {
		theme-id: 201
		layout-engine: elk
		theme-overrides: {
			N7: black

			# mach border
			B1: "#5F5C5C"
			B2: grey
			B3: "#6C7086"
			# mach background
			B4: "#262424"
			B5: "#45475A"
			B6: "#313244"

			AA2: "#f38BA8"
			AA4: "#45475A"
			AA5: "#313244"

			AB4: "#45475A"
			AB5: "#313244"
		}
	}
}
classes: {
	net: {
		style: {
			font-size: 22
			fill: "#262424"
			stroke: "#6C7086"
			font-color: white
			border-radius: 8
		}
	}
	sink: {
		style: {
			font-size: 24
			fill: "#f9e2af"
			stroke: "#45475A"
			font-color: black
			border-radius: 8
		}
	}
	# parent hierarchy relation
	parent: {
		style.stroke: white
		style.stroke-width: 4
		target-arrowhead.shape: circle
	}
	# rpc / ring relation
	ring: {
		style: {
			stroke: "orange"
			stroke-width: 6
		}
	}
}
direction: right

c0_sink: "c0 sink\nGQL DB" {class: sink}
