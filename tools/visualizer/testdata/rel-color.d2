	direction: right

a: "" {
	class: [M_tbot-dev; mach]
	style.stroke: yellow

	b:BaseDBStarting
	b.class: [state; _0]
	b <--> c: double remove {
		class: [M_tbot-dev; F_BaseDBStarting; T_BaseDBReady; rem2]
	}
	d:CharacterReady
	d.class: [state; _0]
	d <--> e: double remove {
		class: [M_tbot-dev; F_CharacterReady; T_RestoreCharacter; rem2; rel-zoom]
	}
	d <--> f: double remove {
		class: [M_tbot-dev; F_CharacterReady; T_GenCharacter; rem2]
	}
	f:GenCharacter
	f.class: [state; _0]
	f --> c: require {
		class: [M_tbot-dev; F_GenCharacter; T_BaseDBReady; req]
	}
	f <--> e: double remove {
		class: [M_tbot-dev; F_GenCharacter; T_RestoreCharacter; rem2; rel-zoom]
	}
	c:BaseDBReady
	c.class: [state; _0]
	e:RestoreCharacter
	e.class: [state; _0; state-zoom]
	e --> c: require {
		class: [M_tbot-dev; F_RestoreCharacter; T_BaseDBReady; req; rel-zoom]
	}
}


